{
  "expo": {
    "name": "profit.exe - AI-Powered Business Intelligence for Small Merchants",
    "slug": "profit-exe",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.profitexe.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFC"
      },
      "package": "com.profitexe.app"
    },
    "web": {
      "bundler": "metro"
    },
    "scheme": "profit-exe",
    "plugins": ["expo-router"]
  }
}
